---
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-sans-condensed/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import { perfil, portafolios } from '../data/enlaces';

interface Props {
  titulo: string;
  descripcion: string;
}

const { titulo, descripcion } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('og.png', Astro.site).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: perfil.nombre,
  jobTitle: perfil.rol,
  email: `mailto:${perfil.email}`,
  url: canonical,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Roma',
    addressCountry: 'IT',
  },
  knowsAbout: [
    'Arquitectura de soluciones',
    'Ingeniería de datos',
    'Cloud computing',
    'Business Intelligence',
    'Desarrollo full-stack',
  ],
  sameAs: [perfil.linkedin, perfil.github, ...portafolios.map((p) => p.url)],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a1520" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
  </head>
  <body>
    <div class="ambiente" aria-hidden="true">
      <span class="luz luz-1"></span>
      <span class="luz luz-2"></span>
      <span class="luz luz-3"></span>
    </div>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --paper: #e7ebf0;
    --surface: #ffffff;
    --ink: #0d1b2a;
    --ink-2: #4a5b6e;
    --rule: #c4d0dc;

    --accent: #0a6376;
    --accent-2: #6d3bbf;
    --accent-3: #c2415f;

    --activo: #14684a;
    --construccion: #7d5410;

    --sans: 'IBM Plex Sans Variable', system-ui, sans-serif;
    --display: 'IBM Plex Sans Condensed', var(--sans);
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #0a1520;
      --surface: #101e2c;
      --ink: #e5ecf3;
      --ink-2: #93a5b7;
      --rule: #22374a;

      --accent: #5cc6da;
      --accent-2: #a78bfa;
      --accent-3: #f472a3;

      --activo: #4bbd93;
      --construccion: #d3a044;

    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background-color: var(--paper);
  }

  body {
    position: relative;
    margin: 0;
    min-height: 100vh;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* Capa de ambiente: rejilla + circuiteria + luces a la deriva.
     Colores literales a proposito: esta capa debe funcionar
     aunque cualquier variable falle. */
  .ambiente {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background-color: #0a1520;
    background-image:
      radial-gradient(circle at 50% 50%, rgba(92, 198, 218, 0.5) 1.5px, transparent 1.6px),
      repeating-linear-gradient(45deg, transparent 0 27px, rgba(167, 139, 250, 0.13) 27px 28px),
      repeating-linear-gradient(-45deg, transparent 0 27px, rgba(244, 114, 163, 0.1) 27px 28px),
      linear-gradient(to right, rgba(34, 55, 74, 0.7) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(34, 55, 74, 0.7) 1px, transparent 1px);
    background-size: 56px 56px, auto, auto, 28px 28px, 28px 28px;
  }

  .luz {
    position: absolute;
    border-radius: 50%;
    opacity: 0.42;
  }

  .luz-1 {
    top: -25%;
    left: -20%;
    width: 70vw;
    height: 70vw;
    background: radial-gradient(circle, #5cc6da 0%, transparent 62%);
    animation: deriva-1 26s ease-in-out infinite alternate;
  }

  .luz-2 {
    bottom: -30%;
    right: -22%;
    width: 75vw;
    height: 75vw;
    background: radial-gradient(circle, #a78bfa 0%, transparent 62%);
    animation: deriva-2 32s ease-in-out infinite alternate;
  }

  .luz-3 {
    top: 28%;
    right: 12%;
    width: 50vw;
    height: 50vw;
    background: radial-gradient(circle, #f472a3 0%, transparent 65%);
    animation: deriva-3 38s ease-in-out infinite alternate;
  }

  @keyframes deriva-1 {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(12vw, 8vh) scale(1.15); }
  }

  @keyframes deriva-2 {
    from { transform: translate(0, 0) scale(1.08); }
    to { transform: translate(-13vw, -9vh) scale(0.94); }
  }

  @keyframes deriva-3 {
    from { transform: translate(0, 0) scale(0.92); }
    to { transform: translate(-8vw, 11vh) scale(1.2); }
  }

  main {
    position: relative;
    z-index: 1;
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .luz {
      animation: none !important;
    }
  }
</style>