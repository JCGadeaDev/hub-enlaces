---
import Base from '../layouts/Base.astro';
import { perfil } from '../data/enlaces';

const titulo = `Página no encontrada — ${perfil.nombre}`;
const descripcion = 'La dirección solicitada no existe en este sitio.';
---

<Base titulo={titulo} descripcion={descripcion}>
  <main>
    <div class="hoja">
      <span class="marca marca-si" aria-hidden="true"></span>
      <span class="marca marca-sd" aria-hidden="true"></span>
      <span class="marca marca-ii" aria-hidden="true"></span>
      <span class="marca marca-id" aria-hidden="true"></span>

      <p class="codigo">Error 404</p>
      <h1>Página no encontrada</h1>
      <p class="texto">
        La dirección que buscas no existe o ha cambiado de sitio.
      </p>
      <a class="volver" href="/">Volver al inicio</a>
    </div>
  </main>
</Base>

<style>
  main {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: clamp(24px, 6vw, 72px) 20px;
  }

  .hoja {
    position: relative;
    width: 100%;
    max-width: 620px;
    padding: clamp(32px, 6vw, 56px);
    background: color-mix(in srgb, var(--surface) 96%, transparent);
    border: 1px solid var(--rule);
    border-radius: 4px;
    text-align: center;
  }

  .marca {
    position: absolute;
    width: 11px;
    height: 11px;
    border: 1px solid var(--accent);
  }
  .marca-si { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
  .marca-sd { top: -1px; right: -1px; border-left: 0; border-bottom: 0; }
  .marca-ii { bottom: -1px; left: -1px; border-right: 0; border-top: 0; }
  .marca-id { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }

  .codigo {
    margin: 0;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  h1 {
    position: relative;
    margin: 12px 0 18px;
    padding-bottom: 16px;
    font-family: var(--display);
    font-size: clamp(26px, 5.2vw, 34px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  h1::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: 84px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, #5cc6da, #a78bfa, #f472a3);
  }

  .texto {
    margin: 0 auto 28px;
    max-width: 42ch;
    font-size: 15px;
    color: var(--ink-2);
  }

  .volver {
    display: inline-block;
    padding: 11px 22px;
    border: 1px solid var(--rule);
    border-radius: 10px;
    font-family: var(--mono);
    font-size: 13px;
    text-decoration: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .volver:hover,
  .volver:focus-visible {
    border-color: color-mix(in srgb, var(--accent-2) 50%, var(--rule));
    box-shadow: 0 6px 20px -12px color-mix(in srgb, var(--accent-2) 80%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .volver { transition: none; }
  }
</style>