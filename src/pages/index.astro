---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import TarjetaEnlace from '../components/TarjetaEnlace.astro';
import foto from '../assets/foto-perfil.png';
import { perfil, portafolios, blogs, contacto } from '../data/enlaces';

const titulo = `${perfil.nombre} — ${perfil.rol}`;
const descripcion = `Portafolios, blogs y contacto de ${perfil.nombre}, ${perfil.rol} especializado en ${perfil.especialidad}. Basado en ${perfil.ubicacion}.`;
---

<Base titulo={titulo} descripcion={descripcion}>
  <main>
    <div class="hoja">
      <span class="marca marca-si" aria-hidden="true"></span>
      <span class="marca marca-sd" aria-hidden="true"></span>
      <span class="marca marca-ii" aria-hidden="true"></span>
      <span class="marca marca-id" aria-hidden="true"></span>

      <button class="compartir-perfil" type="button" aria-label="Compartir mi perfil">
        <Icon name="lucide:share-2" width={18} height={18} />
        <span class="aviso-perfil" role="status"></span>
      </button>

      <header>
        <div class="anillo">
          <Image
            src={foto}
            alt={`Retrato de ${perfil.nombre}`}
            width={124}
            height={124}
            densities={[1, 2]}
            format="avif"
            loading="eager"
            fetchpriority="high"
            class="retrato"
          />
        </div>
        <h1>{perfil.nombre}</h1>
        <p class="rol">{perfil.rol}</p>
        <p class="especialidad">{perfil.especialidad}</p>
      </header>

      <p class="meta">
        <span>{perfil.ubicacion}</span>
        <span class="sep" aria-hidden="true">/</span>
        <span>{perfil.disponibilidad}</span>
      </p>

      <section aria-labelledby="t-portafolios">
        <h2 id="t-portafolios">Portafolios</h2>
        <div class="lista">
          {portafolios.map((e, i) => <TarjetaEnlace {...e} indice={i} />)}
        </div>
      </section>

      <section aria-labelledby="t-blogs">
        <h2 id="t-blogs">Blogs</h2>
        <div class="lista">
          {blogs.map((e, i) => <TarjetaEnlace {...e} indice={i + 2} />)}
        </div>
      </section>

      <section aria-labelledby="t-contacto">
        <h2 id="t-contacto">Contacto</h2>
        <ul class="contacto">
          {
            contacto.map((c) => (
              <li>
                <a href={c.url} rel="me noopener">
                  <span class="etiqueta">
                    <Icon name={c.icono} width={16} height={16} />
                    {c.etiqueta}
                  </span>
                  <span class="valor">{c.host}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <footer>
        <span>{new Date().getFullYear()}</span>
        <span class="sep" aria-hidden="true">/</span>
        <span>Desarrollado por JCGadeaDev | Hecho con Astro</span>
      </footer>
    </div>
  </main>
</Base>

<style>
  main {
    display: flex;
    justify-content: center;
    padding: clamp(24px, 6vw, 72px) 20px;
  }

  .hoja {
    position: relative;
    width: 100%;
    max-width: 620px;
    padding: clamp(26px, 5vw, 44px);
    background: color-mix(in srgb, var(--surface) 96%, transparent);
    border: 1px solid var(--rule);
    border-radius: 4px;
  }

  .marca {
    position: absolute;
    width: 11px;
    height: 11px;
    border: 1px solid var(--accent);
  }
  .marca-si { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
  .marca-sd { top: -1px; right: -1px; border-left: 0; border-bottom: 0; }
  .marca-ii { bottom: -1px; left: -1px; border-right: 0; border-top: 0; }
  .marca-id { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }

  .compartir-perfil {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink-2);
    cursor: pointer;
    transition: color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .compartir-perfil:hover,
  .compartir-perfil:focus-visible {
    color: var(--accent-2);
    border-color: color-mix(in srgb, var(--accent-2) 45%, var(--rule));
    box-shadow: 0 4px 16px -8px color-mix(in srgb, var(--accent-2) 80%, transparent);
  }

  .aviso-perfil {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    padding: 3px 7px;
    border-radius: 6px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 10px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .compartir-perfil.copiado .aviso-perfil { opacity: 1; }

  header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .anillo {
    padding: 3px;
    margin-bottom: 20px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, #5cc6da, #a78bfa, #f472a3, #5cc6da);
    animation: girar 9s linear infinite;
  }

  .retrato {
    display: block;
    border-radius: 50%;
    border: 3px solid var(--surface);
    object-fit: cover;
  }

  h1 {
    position: relative;
    margin: 0 0 14px;
    padding-bottom: 14px;
    font-family: var(--display);
    font-size: clamp(28px, 5.6vw, 37px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  h1::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: 84px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, #5cc6da, #a78bfa, #f472a3);
  }

  .rol {
    margin: 10px 0 0;
    font-size: 15.5px;
    color: var(--ink-2);
  }

  .especialidad {
    margin: 4px 0 0;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--accent);
  }

  .meta {
    margin: 22px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
    text-align: center;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .sep {
    margin: 0 8px;
    color: var(--rule);
  }

  section { margin-top: 34px; }

  h2 {
    margin: 0 0 14px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .lista { display: grid; gap: 12px; }

  .contacto {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contacto a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 11px 14px;
    border: 1px solid var(--rule);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .contacto a:hover,
  .contacto a:focus-visible {
    border-color: color-mix(in srgb, var(--accent-2) 45%, var(--rule));
    box-shadow: 0 4px 16px -10px color-mix(in srgb, var(--accent-2) 70%, transparent);
  }

  .etiqueta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
  }

  .valor {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-2);
    text-align: right;
    word-break: break-all;
  }

  footer {
    margin-top: 34px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
    text-align: center;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--ink-2);
  }

  @keyframes girar {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .anillo { animation: none; }
    .contacto a,
    .compartir-perfil { transition: none; }
  }

  @media (max-width: 430px) {
    .compartir-perfil { top: 12px; right: 12px; width: 34px; height: 34px; }
    .contacto a {
      flex-direction: column;
      align-items: flex-start;
      gap: 3px;
    }
    .valor { text-align: left; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.compartir-perfil');
  const aviso = btn?.querySelector('.aviso-perfil');

  btn?.addEventListener('click', async () => {
    const datos = {
      title: document.title,
      text: 'Portafolios, blogs y contacto',
      url: location.href,
    };

    try {
      if (navigator.share) {
        await navigator.share(datos);
      } else {
        await navigator.clipboard.writeText(datos.url);
        if (aviso) aviso.textContent = 'Enlace copiado';
        btn.classList.add('copiado');
        setTimeout(() => btn.classList.remove('copiado'), 1600);
      }
    } catch {
      // El usuario cerró el diálogo del sistema: no es un error.
    }
  });
</script>